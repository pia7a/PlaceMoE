# Copy this file to configs/placemoe/gpu_ep32.env and adjust every path and host.
# Environment variables supplied by the caller take precedence over this file.

# Repository and Python environment shared by all four nodes.
PLACEMOE_REPRO_PYTHON="${PLACEMOE_REPRO_PYTHON:-/absolute/path/to/PlaceMoE/.venv/bin/python}"
PLACEMOE_REPRO_REMOTE_REPO_ROOT="${PLACEMOE_REPRO_REMOTE_REPO_ROOT:-/absolute/path/to/PlaceMoE}"

# Rank 0 runs locally. Ranks 1-3 are reached through one SSH endpoint and
# distinct proxy ports. Authentication stays in PLACEMOE_REPRO_SSH_KEY,
# PLACEMOE_REPRO_SSH_PASSWORD, or SSH_AUTH_SOCK and must never be stored here.
PLACEMOE_REPRO_SSH_USER="${PLACEMOE_REPRO_SSH_USER:-root}"
PLACEMOE_REPRO_SSH_HOST="${PLACEMOE_REPRO_SSH_HOST:-gpu-proxy.example.com}"
PLACEMOE_REPRO_RANK1_PORT="${PLACEMOE_REPRO_RANK1_PORT:-30001}"
PLACEMOE_REPRO_RANK2_PORT="${PLACEMOE_REPRO_RANK2_PORT:-30002}"
PLACEMOE_REPRO_RANK3_PORT="${PLACEMOE_REPRO_RANK3_PORT:-30003}"
PLACEMOE_REPRO_SSH_STRICT_HOST_KEY_CHECKING="${PLACEMOE_REPRO_SSH_STRICT_HOST_KEY_CHECKING:-accept-new}"
PLACEMOE_REPRO_SSH_KNOWN_HOSTS_FILE="${PLACEMOE_REPRO_SSH_KNOWN_HOSTS_FILE:-}"
PLACEMOE_REPRO_MASTER_ADDR="${PLACEMOE_REPRO_MASTER_ADDR:-10.0.0.1}"
PLACEMOE_REPRO_NCCL_SOCKET_IFNAME="${PLACEMOE_REPRO_NCCL_SOCKET_IFNAME:-ibs0}"
PLACEMOE_REPRO_CUDA_LIB_PATH="${PLACEMOE_REPRO_CUDA_LIB_PATH:-}"

# Model, dataset, and reference EPLB implementation paths.
PLACEMOE_REPRO_QWEN3VL_MODEL_PATH="${PLACEMOE_REPRO_QWEN3VL_MODEL_PATH:-/absolute/path/to/Qwen3-VL-30B-A3B-Instruct}"
PLACEMOE_REPRO_QWEN35_MODEL_PATH="${PLACEMOE_REPRO_QWEN35_MODEL_PATH:-/absolute/path/to/Qwen3.5-35B-A3B-20L}"
PLACEMOE_REPRO_SHAREGPT4V_DATA_PATH="${PLACEMOE_REPRO_SHAREGPT4V_DATA_PATH:-/absolute/path/to/sharegpt4v.json}"
PLACEMOE_REPRO_TULU3_DATA_PATH="${PLACEMOE_REPRO_TULU3_DATA_PATH:-/absolute/path/to/tulu3.parquet}"
PLACEMOE_REPRO_EPLB_ROOT="${PLACEMOE_REPRO_EPLB_ROOT:-/absolute/path/to/EPLB}"

# Preflight software contract. Keep these values identical on every node.
PLACEMOE_REPRO_EXPECTED_ACCELERATOR="${PLACEMOE_REPRO_EXPECTED_ACCELERATOR:-NVIDIA RTX A6000}"
PLACEMOE_REPRO_EXPECTED_TORCH="${PLACEMOE_REPRO_EXPECTED_TORCH:-2.9.1+cu129}"
PLACEMOE_REPRO_EXPECTED_CUDA="${PLACEMOE_REPRO_EXPECTED_CUDA:-12.9}"
PLACEMOE_REPRO_EXPECTED_NCCL="${PLACEMOE_REPRO_EXPECTED_NCCL:-2.27.5}"
PLACEMOE_REPRO_EXPECTED_TRITON="${PLACEMOE_REPRO_EXPECTED_TRITON:-3.5.1}"

# Topology-aware local CUDA order. The hierarchy is 2,8,32 by default.
PLACEMOE_REPRO_RANK0_DEVICE_ORDER="${PLACEMOE_REPRO_RANK0_DEVICE_ORDER:-0,1,2,7,3,4,5,6}"
PLACEMOE_REPRO_REMOTE_DEVICE_ORDER="${PLACEMOE_REPRO_REMOTE_DEVICE_ORDER:-0,1,2,3,4,5,6,7}"
PLACEMOE_REPRO_HIERARCHY_GROUP_SIZES="${PLACEMOE_REPRO_HIERARCHY_GROUP_SIZES:-2,8,32}"

# Formal matrix defaults: one fixed-order run per method, five optimizer
# steps, and the mean of steps 3-5. Set PLACEMOE_REPRO_CONFIRM_FULL=1 at launch time.
PLACEMOE_REPRO_MODELS="${PLACEMOE_REPRO_MODELS:-qwen3vl}"
PLACEMOE_REPRO_DATASETS="${PLACEMOE_REPRO_DATASETS:-sharegpt4v tulu3}"
PLACEMOE_REPRO_METHODS="${PLACEMOE_REPRO_METHODS:-baseline r2 eplb ours}"
PLACEMOE_REPRO_REPEATS="${PLACEMOE_REPRO_REPEATS:-1}"
PLACEMOE_REPRO_GRAD_PROTOCOL="${PLACEMOE_REPRO_GRAD_PROTOCOL:-paper}"
PLACEMOE_REPRO_E2E_SOURCE="${PLACEMOE_REPRO_E2E_SOURCE:-env_step_time_s}"
